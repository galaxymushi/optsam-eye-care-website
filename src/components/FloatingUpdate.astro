---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { base } from '../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts[0];

// Never float a pointer to the page the visitor is already reading.
const postHref = latest ? `${base}/blog/${latest.id}` : '';
const isCurrentPage = latest ? Astro.url.pathname.replace(/\/+$/, '') === postHref : true;

const visible = latest && !isCurrentPage;
---

{visible && latest && (
  <div class="float-update" data-float-update data-update-id={latest.id}>
    <a
      class="float-update__link"
      href={postHref}
      aria-label={`New update: ${latest.data.title}. Soma makala.`}
    >
      <span class="float-update__badge">
        <span class="float-update__dot" aria-hidden="true"></span>
        New update
      </span>
      <span class="float-update__title">{latest.data.title}</span>
      <span class="float-update__go" aria-hidden="true">
        <Icon name="arrow-up-right" size={15} />
      </span>
    </a>
    <button
      class="float-update__close"
      type="button"
      aria-label="Funga tangazo hili"
      data-float-close
    >
      <Icon name="close" size={13} strokeWidth={2} />
    </button>
  </div>
)}

<script>
  const el = document.querySelector<HTMLElement>('[data-float-update]');
  if (el) {
    const STORE_KEY = 'optsam-update-dismissed';
    const id = el.dataset.updateId ?? '';

    let dismissed: Record<string, boolean> = {};
    try {
      dismissed = JSON.parse(sessionStorage.getItem(STORE_KEY) ?? '{}');
    } catch {
      dismissed = {};
    }

    if (dismissed[id]) {
      el.remove();
    } else {
      window.setTimeout(() => el.classList.add('is-visible'), 900);

      el.querySelector('[data-float-close]')?.addEventListener('click', () => {
        dismissed[id] = true;
        try {
          sessionStorage.setItem(STORE_KEY, JSON.stringify(dismissed));
        } catch {
          /* storage unavailable — dismissal lasts for this page only */
        }
        el.classList.remove('is-visible');
        window.setTimeout(() => el.remove(), 320);
      });
    }
  }
</script>

<style>
  .float-update {
    position: fixed;
    right: clamp(0.9rem, 2.5vw, 1.6rem);
    bottom: clamp(0.9rem, 2.5vw, 1.6rem);
    bottom: calc(clamp(0.9rem, 2.5vw, 1.6rem) + env(safe-area-inset-bottom, 0px));
    z-index: 80;
    inline-size: min(92vw, 21rem);
    opacity: 0;
    transform: translateY(0.9rem);
    pointer-events: none;
    transition: opacity 320ms var(--ease), transform 320ms var(--ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .float-update {
      transition: none;
    }
  }

  .float-update.is-visible {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  .float-update__link {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.7rem;
    padding: 0.9rem 1rem;
    background: var(--ink-2);
    color: var(--paper);
    text-decoration: none;
    border: 1px solid var(--line-light-strong);
    border-radius: 0.9rem;
    box-shadow: 0 18px 44px rgba(10, 29, 38, 0.38);
    transition: background 220ms var(--ease), transform 220ms var(--ease);
  }

  .float-update__link:hover {
    background: var(--ink-3);
    transform: translateY(-2px);
  }

  .float-update__badge {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.56rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal-light);
  }

  .float-update__dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--teal-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .float-update__dot {
      animation: float-pulse 2.1s ease-in-out infinite;
    }

    @keyframes float-pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(44, 140, 148, 0.55); }
      50% { opacity: 0.65; box-shadow: 0 0 0 5px rgba(44, 140, 148, 0); }
    }
  }

  .float-update__title {
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-family: var(--serif);
    font-size: 0.92rem;
    line-height: 1.3;
    color: var(--paper);
  }

  .float-update__go {
    display: grid;
    place-items: center;
    inline-size: 2rem;
    block-size: 2rem;
    border: 1px solid var(--line-light);
    border-radius: 50%;
    color: var(--teal-light);
    transition: background 200ms var(--ease), color 200ms var(--ease);
  }

  .float-update__link:hover .float-update__go {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--paper);
  }

  .float-update__close {
    position: absolute;
    top: -0.55rem;
    right: -0.55rem;
    display: grid;
    place-items: center;
    inline-size: 1.6rem;
    block-size: 1.6rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: var(--paper);
    color: var(--muted);
    box-shadow: 0 4px 12px rgba(10, 29, 38, 0.18);
    transition: background 200ms var(--ease), color 200ms var(--ease);
  }

  .float-update__close:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--paper);
  }
</style>
