---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { base, nav, site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer theme-dark">
  <div class="wrap">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo tone="light" />
        <p>
          Primary eye care and an optical workshop in Mbagala, Dar es Salaam.
          Founded by Optometrist J.M. Samwel.
        </p>
        <a class="link-arrow" href={`${base}/contact`}>
          Talk to Optsam
          <Icon name="arrow-right" size={16} />
        </a>
      </div>

      <nav class="site-footer__nav" aria-label="Footer">
        <p class="site-footer__label">Explore</p>
        <ul>
          {nav.map((item) => (
            <li><a href={item.href}>{item.label}</a></li>
          ))}
          <li><a href={`${base}/sources`}>Sources &amp; photo credits</a></li>
          <li><a href={`${base}/privacy`}>Privacy</a></li>
        </ul>
      </nav>

      <div class="site-footer__contact">
        <p class="site-footer__label">Visit &amp; contact</p>
        <ul class="contact-list">
          <li>
            <Icon name="pin" size={17} />
            <a href={site.directionsHref} target="_blank" rel="noopener">
              {site.address.street}, {site.address.area}<br />
              {site.address.city}, {site.address.country}
            </a>
          </li>
          <li>
            <Icon name="phone" size={17} />
            <a href={site.phoneHref}>{site.phoneDisplay}</a>
          </li>
          <li>
            <Icon name="mail" size={17} />
            <a href={site.emailHref}>{site.email}</a>
          </li>
        </ul>
        <p class="site-footer__note">{site.availabilityNote}</p>
      </div>

      <div class="site-footer__social">
        <p class="site-footer__label">Follow</p>
        <ul>
          {site.socials.map((social) => (
            <li>
              <a href={social.href} target="_blank" rel="noopener">
                <Icon
                  name={social.label === 'Instagram' ? 'instagram' : social.label === 'YouTube' ? 'youtube' : 'external'}
                  size={17}
                />
                {social.label}
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="site-footer__statement" aria-hidden="true">Optsam</p>

    <div class="site-footer__bottom">
      <p>© {year} Optsam Eye Care and Optical Workshop Store.</p>
      <p class="site-footer__meta">
        Mbagala, Dar es Salaam · <a href={`${base}/sources`}>Verification record</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3.5rem, 7vw, 6rem);
    overflow: hidden;
    border-top: 1px solid var(--line-light);
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.35fr 0.65fr 1fr 0.6fr;
    gap: clamp(2rem, 4vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .site-footer__brand p {
    margin-top: 1.4rem;
    max-width: 31ch;
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(247, 244, 238, 0.62);
  }

  .site-footer__brand .link-arrow {
    margin-top: 1.4rem;
  }

  .site-footer__label {
    margin-bottom: 1.1rem;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: var(--brass-light);
  }

  .site-footer__nav ul,
  .site-footer__social ul {
    display: grid;
    gap: 0.55rem;
  }

  .site-footer__nav a,
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: rgba(247, 244, 238, 0.72);
    font-size: 0.86rem;
    text-decoration: none;
    transition: color 200ms var(--ease);
  }

  .site-footer__nav a:hover,
  .site-footer__social a:hover {
    color: var(--paper);
  }

  .contact-list {
    display: grid;
    gap: 0.85rem;
  }

  .contact-list li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.65rem;
    align-items: start;
    color: rgba(247, 244, 238, 0.72);
  }

  .contact-list svg {
    margin-top: 0.22rem;
    color: var(--teal-light);
  }

  .contact-list a {
    font-size: 0.86rem;
    line-height: 1.55;
    text-decoration: none;
  }

  .contact-list a:hover {
    color: var(--paper);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__note {
    margin-top: 1.4rem;
    max-width: 34ch;
    font-size: 0.7rem;
    line-height: 1.55;
    color: rgba(247, 244, 238, 0.42);
  }

  .site-footer__statement {
    font-family: var(--serif);
    font-size: clamp(6rem, 20vw, 16.5rem);
    line-height: 0.68;
    letter-spacing: -0.035em;
    color: transparent;
    -webkit-text-stroke: 1px rgba(247, 244, 238, 0.16);
    text-align: center;
    user-select: none;
    transform: translateY(0.1em);
  }

  .site-footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    padding-block: 1.35rem;
    border-top: 1px solid var(--line-light);
    color: rgba(247, 244, 238, 0.46);
    font-size: 0.7rem;
    letter-spacing: 0.01em;
  }

  .site-footer__meta a {
    color: inherit;
  }

  .site-footer__meta a:hover {
    color: var(--paper);
  }

  @media (max-width: 980px) {
    .site-footer__top {
      grid-template-columns: 1fr 1fr;
      row-gap: 3rem;
    }

    .site-footer__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .site-footer__top {
      grid-template-columns: 1fr;
    }

    .site-footer__brand {
      grid-column: auto;
    }

    .site-footer__statement {
      font-size: clamp(5.5rem, 28vw, 8rem);
    }
  }
</style>
