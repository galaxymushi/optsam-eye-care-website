---
import { Image } from 'astro:assets';
import logo from '../assets/optsam-logo.png';
import { base } from '../data/site';

interface Props {
  tone?: 'dark' | 'light';
  compact?: boolean;
}

const { tone = 'light', compact = false } = Astro.props;
---

<a class:list={['logo', `logo--${tone}`, { 'logo--compact': compact }]} href={`${base}/`} aria-label="Optsam Eye Care — home">
  <span class="logo__badge">
    <Image src={logo} alt="" width={96} height={96} loading="eager" />
  </span>
  <span class="logo__type">
    <span class="logo__name">Optsam</span>
    {!compact && <span class="logo__sub">Eye care &amp; optical workshop</span>}
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--paper);
    text-decoration: none;
    line-height: 1;
  }

  .logo--dark {
    color: var(--ink);
  }

  .logo__badge {
    display: block;
    inline-size: 2.9rem;
    block-size: 2.9rem;
    padding: 2px;
    border-radius: 50%;
    overflow: hidden;
    flex: none;
    background: rgba(247, 244, 238, 0.92);
    box-shadow: 0 0 0 1px rgba(247, 244, 238, 0.45);
  }

  .logo__badge :global(img) {
    border-radius: 50%;
  }

  .logo--dark .logo__badge {
    background: rgba(10, 29, 38, 0.06);
    box-shadow: 0 0 0 1px rgba(10, 29, 38, 0.16);
  }

  .logo__badge :global(img) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  .logo__type {
    display: flex;
    flex-direction: column;
    gap: 0.24rem;
  }

  .logo__name {
    font-family: var(--serif);
    font-size: 1.55rem;
    line-height: 0.8;
    letter-spacing: -0.01em;
  }

  .logo__sub {
    font-family: var(--sans);
    font-size: 0.5rem;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    opacity: 0.62;
  }

  .logo--compact .logo__name {
    font-size: 1.35rem;
  }

  @media (max-width: 420px) {
    .logo__sub {
      display: none;
    }

    .logo__badge {
      inline-size: 2.35rem;
      block-size: 2.35rem;
    }
  }
</style>
