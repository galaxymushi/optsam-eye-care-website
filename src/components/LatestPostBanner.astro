---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';
import { base } from '../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const latest = posts[0];

const monthNames = [
  'Januari', 'Februari', 'Machi', 'Aprili', 'Mei', 'Juni',
  'Julai', 'Agosti', 'Septemba', 'Oktoba', 'Novemba', 'Desemba',
];

const formatDate = (date: Date) =>
  `${date.getUTCDate()} ${monthNames[date.getUTCMonth()]} ${date.getUTCFullYear()}`;
---

{latest && (
  <a
    class="update-bar"
    href={`${base}/blog/${latest.id}`}
    aria-label={`New update: ${latest.data.title} — soma makala`}
  >
    <div class="wrap update-bar__inner">
      <span class="update-bar__badge">
        <span class="update-bar__dot" aria-hidden="true"></span>
        New update
      </span>
      <span class="update-bar__text">
        <span class="update-bar__title">{latest.data.title}</span>
        <span class="update-bar__meta">
          {latest.data.author} · {formatDate(latest.data.pubDate)}
        </span>
      </span>
      <span class="update-bar__cta">
        Soma makala
        <Icon name="arrow-up-right" size={15} />
      </span>
    </div>
  </a>
)}

<style>
  .update-bar {
    display: block;
    background: var(--ink-2);
    color: var(--paper);
    text-decoration: none;
    border-bottom: 1px solid var(--line-light);
    transition: background 250ms var(--ease);
  }

  .update-bar:hover {
    background: var(--ink-3);
  }

  .update-bar__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: 0.85rem;
  }

  .update-bar__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.32rem 0.7rem;
    border: 1px solid var(--line-light-strong);
    border-radius: 999px;
    font-size: 0.6rem;
    font-weight: 750;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--teal-light);
    white-space: nowrap;
  }

  .update-bar__dot {
    inline-size: 6px;
    block-size: 6px;
    border-radius: 50%;
    background: var(--teal-bright);
  }

  @media (prefers-reduced-motion: no-preference) {
    .update-bar__dot {
      animation: update-pulse 2.1s ease-in-out infinite;
    }

    @keyframes update-pulse {
      0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(44, 140, 148, 0.55); }
      50% { opacity: 0.65; box-shadow: 0 0 0 5px rgba(44, 140, 148, 0); }
    }
  }

  .update-bar__text {
    display: block;
    min-width: 0;
  }

  .update-bar__title {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-family: var(--serif);
    font-size: clamp(1rem, 1.7vw, 1.25rem);
    line-height: 1.25;
    color: var(--paper);
  }

  .update-bar__meta {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(247, 244, 238, 0.55);
  }

  .update-bar__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--teal-light);
    white-space: nowrap;
  }

  .update-bar:hover .update-bar__cta {
    color: var(--paper);
  }

  .update-bar__cta :global(svg) {
    transition: transform 220ms var(--ease);
  }

  .update-bar:hover .update-bar__cta :global(svg) {
    transform: translate(2px, -2px);
  }

  @media (max-width: 720px) {
    .update-bar__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.35rem;
    }

    .update-bar__badge {
      grid-column: 1;
      grid-row: 1;
      justify-self: start;
    }

    .update-bar__text {
      grid-column: 1;
      grid-row: 2;
    }

    .update-bar__title {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      font-size: 0.95rem;
    }

    .update-bar__meta {
      display: none;
    }

    .update-bar__cta {
      grid-column: 2;
      grid-row: 2;
      align-self: center;
    }
  }
</style>
