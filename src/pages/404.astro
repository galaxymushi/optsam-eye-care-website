---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { base, site } from '../data/site';
---

<Base
  title="Page not found"
  description="This page could not be found. Return to Optsam Eye Care or contact the practice in Mbagala, Dar es Salaam."
  noindex
>
  <section class="not-found">
    <div class="wrap not-found__grid">
      <div class="not-found__copy">
        <p class="eyebrow">404 · Page not found</p>
        <h1>This page is<br /><em>out of focus.</em></h1>
        <p class="lede">
          The page you were looking for is not here. It may have moved, or the link
          may be incomplete.
        </p>
        <div class="not-found__actions">
          <a class="btn btn--primary" href={`${base}/`}>
            Back to Optsam
            <Icon name="arrow-right" size={16} />
          </a>
          <a class="btn btn--ghost" href={`${base}/contact`}>Contact us</a>
        </div>
        <p class="not-found__call">
          Or call <a href={site.phoneHref}>{site.phoneDisplay}</a>
        </p>
      </div>

      <div class="not-found__chart" aria-hidden="true">
        <p class="not-found__row not-found__row--1">4</p>
        <p class="not-found__row not-found__row--2">0</p>
        <p class="not-found__row not-found__row--3">4</p>
        <p class="not-found__row not-found__row--4">O P T S A M</p>
        <p class="not-found__row not-found__row--5">E F P T O Z</p>
        <p class="not-found__caption">A quick test. This one is not a diagnosis.</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    padding-block: clamp(4rem, 10vw, 9rem);
    min-block-size: 62vh;
    display: grid;
    align-items: center;
  }

  .not-found__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.75fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }

  .not-found h1 {
    margin-top: 1.2rem;
  }

  .not-found .lede {
    margin-top: 1.5rem;
    max-width: 38ch;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 2rem;
  }

  .not-found__call {
    margin-top: 1.2rem;
    font-size: 0.8rem;
    color: var(--quiet);
  }

  .not-found__call a {
    color: var(--ink);
    font-weight: 650;
  }

  .not-found__chart {
    border-left: 1px solid var(--line);
    padding-left: clamp(1.5rem, 4vw, 3rem);
    text-align: center;
  }

  .not-found__row {
    font-family: var(--serif);
    line-height: 0.95;
    color: var(--ink);
  }

  .not-found__row--1 { font-size: clamp(5rem, 10vw, 8rem); }
  .not-found__row--2 { font-size: clamp(4.2rem, 8.4vw, 6.7rem); }
  .not-found__row--3 { font-size: clamp(3.5rem, 7vw, 5.5rem); }
  .not-found__row--4 {
    margin-top: 1.2rem;
    font-family: var(--sans);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.4em;
    color: var(--teal-deep);
  }
  .not-found__row--5 {
    margin-top: 0.5rem;
    font-family: var(--sans);
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.36em;
    color: var(--quiet);
  }

  .not-found__caption {
    margin-top: 1.3rem;
    font-size: 0.64rem;
    letter-spacing: 0.05em;
    color: var(--quiet);
    text-transform: uppercase;
  }

  @media (max-width: 800px) {
    .not-found__grid {
      grid-template-columns: 1fr;
    }

    .not-found__chart {
      border-left: 0;
      border-top: 1px solid var(--line);
      padding-left: 0;
      padding-top: 2rem;
      max-width: 22rem;
    }
  }
</style>
