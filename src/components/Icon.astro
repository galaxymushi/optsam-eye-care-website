---
interface Props {
  name:
    | 'arrow-right'
    | 'arrow-up-right'
    | 'phone'
    | 'mail'
    | 'pin'
    | 'whatsapp'
    | 'instagram'
    | 'youtube'
    | 'external'
    | 'close'
    | 'copy'
    | 'check'
    | 'chevron-down';
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 18, class: className, strokeWidth = 1.5 } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 12h16"></path>
      <path d="m14 6 6 6-6 6"></path>
    </g>
  )}
  {name === 'arrow-up-right' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M7 17 17 7"></path>
      <path d="M8 7h9v9"></path>
    </g>
  )}
  {name === 'external' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M14 4h6v6"></path>
      <path d="M20 4 11 13"></path>
      <path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"></path>
    </g>
  )}
  {name === 'phone' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M7.2 3.5 9 8.1 6.9 9.8a13.3 13.3 0 0 0 7.3 7.3l1.7-2.1 4.6 1.8v2a2 2 0 0 1-2.2 2A18.4 18.4 0 0 1 3.2 5.7a2 2 0 0 1 2-2.2h2Z"></path>
    </g>
  )}
  {name === 'mail' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="1.5"></rect>
      <path d="m3.5 6.5 8.5 6 8.5-6"></path>
    </g>
  )}
  {name === 'pin' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <path d="M20 10.5c0 5-8 11-8 11s-8-6-8-11a8 8 0 1 1 16 0Z"></path>
      <circle cx="12" cy="10.5" r="2.6"></circle>
    </g>
  )}
  {name === 'close' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round">
      <path d="M5 5 19 19M19 5 5 19"></path>
    </g>
  )}
  {name === 'copy' && (
    <g stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round">
      <rect x="8" y="8" width="12" height="12" rx="1.5"></rect>
      <path d="M16 8V5.5A1.5 1.5 0 0 0 14.5 4h-9A1.5 1.5 0 0 0 4 5.5v9A1.5 1.5 0 0 0 5.5 16H8"></path>
    </g>
  )}
  {name === 'check' && (
    <path
      d="m4.5 12.5 5 5 10-11"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  )}
  {name === 'chevron-down' && (
    <path
      d="m6 9 6 6 6-6"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"></path>
  )}
  {name === 'whatsapp' && (
    <path
      fill="currentColor"
      d="M12.04 2a9.9 9.9 0 0 0-8.4 15.16L2.05 22l4.96-1.55A9.9 9.9 0 1 0 12.04 2Zm0 1.8a8.1 8.1 0 1 1-4.16 15.03l-.3-.18-2.94.92.94-2.87-.19-.31A8.1 8.1 0 0 1 12.04 3.8Zm-3.2 4.28c-.17 0-.45.06-.69.31-.24.25-.9.88-.9 2.14 0 1.26.92 2.48 1.05 2.65.13.17 1.77 2.84 4.39 3.86 2.18.85 2.62.68 3.1.63.48-.04 1.54-.62 1.76-1.23.21-.6.21-1.12.15-1.23-.06-.11-.23-.17-.48-.3-.25-.12-1.49-.73-1.72-.82-.23-.08-.4-.12-.56.13-.17.25-.65.82-.8.99-.14.16-.29.18-.54.06-.25-.13-1.06-.4-2.02-1.25-.75-.66-1.25-1.48-1.4-1.73-.14-.25-.01-.38.11-.5.11-.11.25-.3.37-.44.12-.15.16-.25.25-.42.08-.16.04-.31-.02-.43-.06-.12-.56-1.36-.77-1.86-.2-.49-.41-.42-.56-.43h-.46Z"></path>
  )}
  {name === 'instagram' && (
    <g stroke="currentColor" stroke-width={strokeWidth} fill="none">
      <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
      <circle cx="12" cy="12" r="4"></circle>
      <circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle>
    </g>
  )}
  {name === 'youtube' && (
    <g>
      <rect x="2.5" y="5.5" width="19" height="13" rx="4" fill="currentColor"></rect>
      <path d="M10.4 9.2v5.6l4.8-2.8-4.8-2.8Z" fill="var(--paper, #fff)"></path>
    </g>
  )}
</svg>
