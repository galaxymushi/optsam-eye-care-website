---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { base } from '../../data/site';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const monthNames = [
  'Januari', 'Februari', 'Machi', 'Aprili', 'Mei', 'Juni',
  'Julai', 'Agosti', 'Septemba', 'Oktoba', 'Novemba', 'Desemba',
];

const formatDate = (date: Date) =>
  `${date.getUTCDate()} ${monthNames[date.getUTCMonth()]} ${date.getUTCFullYear()}`;

const [latest, ...older] = posts;
---

<Base
  title="Makala"
  description="Makala na mtazamo wa J.M. Samwel kuhusu afya ya macho, uchunguzi wa jamii, na jinsi afya ya macho inavyounga mkono maendeleo ya Tanzania."
>
  <PageHero
    eyebrow="Makala · Blog"
    title="Maneno kutoka kwa <em>mtaalamu.</em>"
    lede="Makala kuhusu afya ya macho, uchunguzi wa jamii, na jinsi uoni mzuri unavyounga mkono maendeleo ya taifa."
    index={`${String(posts.length).padStart(2, '0')} posts`}
  />

  <section class="section">
    <div class="wrap">
      {latest && (
        <a class="latest reveal" href={`${base}/blog/${latest.id}`}>
          <p class="latest__tag">Makala mpya zaidi</p>
          <h2 class="latest__title">{latest.data.title}</h2>
          <p class="latest__desc">{latest.data.description}</p>
          <p class="latest__meta">
            <span>{latest.data.author}</span>
            <span aria-hidden="true">·</span>
            <time datetime={latest.data.pubDate.toISOString()}>{formatDate(latest.data.pubDate)}</time>
          </p>
          <span class="latest__arrow" aria-hidden="true">
            <Icon name="arrow-up-right" size={20} />
          </span>
        </a>
      )}

      {older.length > 0 && (
        <ul class="post-list">
          {older.map((post) => (
            <li class="reveal">
              <a class="post-row" href={`${base}/blog/${post.id}`}>
                <time class="post-row__date" datetime={post.data.pubDate.toISOString()}>
                  {formatDate(post.data.pubDate)}
                </time>
                <h3 class="post-row__title">{post.data.title}</h3>
                <p class="post-row__desc">{post.data.description}</p>
                <span class="post-row__arrow" aria-hidden="true">
                  <Icon name="arrow-up-right" size={18} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .latest {
    position: relative;
    display: block;
    padding: clamp(2rem, 4.5vw, 3.75rem);
    border: 1px solid var(--line-strong);
    background: var(--paper-2);
    color: inherit;
    text-decoration: none;
    transition: background 250ms var(--ease);
  }

  .latest:hover {
    background: var(--paper-3);
  }

  .latest__tag {
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--brass);
  }

  .latest__title {
    margin-top: 1.1rem;
    max-width: 22ch;
    font-size: clamp(1.9rem, 3.6vw, 3.1rem);
    line-height: 1.08;
    transition: color 220ms var(--ease);
  }

  .latest:hover .latest__title {
    color: var(--teal-deep);
  }

  .latest__desc {
    margin-top: 1.1rem;
    max-width: 62ch;
    font-size: 0.92rem;
    line-height: 1.66;
    color: var(--muted);
  }

  .latest__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-top: 1.5rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--quiet);
  }

  .latest__arrow {
    position: absolute;
    right: clamp(1.4rem, 3vw, 2.4rem);
    top: clamp(1.4rem, 3vw, 2.4rem);
    display: grid;
    place-items: center;
    inline-size: 2.6rem;
    block-size: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--teal-deep);
    transition: background 220ms var(--ease), color 220ms var(--ease), border-color 220ms var(--ease);
  }

  .latest:hover .latest__arrow {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--paper);
  }

  .post-list {
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 1px solid var(--line-strong);
  }

  .post-row {
    position: relative;
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1.05fr) minmax(0, 1fr) 2.4rem;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    align-items: center;
    padding-block: clamp(1.35rem, 2.4vw, 1.9rem);
    border-bottom: 1px solid var(--line);
    color: inherit;
    text-decoration: none;
    transition: background 250ms var(--ease), padding 250ms var(--ease);
  }

  .post-row:hover {
    background: color-mix(in srgb, var(--paper) 62%, transparent);
    padding-inline: 0.9rem;
  }

  .post-row__date {
    font-size: 0.72rem;
    font-weight: 650;
    letter-spacing: 0.05em;
    color: var(--brass);
  }

  .post-row__title {
    font-size: clamp(1.25rem, 1.9vw, 1.7rem);
    line-height: 1.2;
    transition: color 220ms var(--ease);
  }

  .post-row:hover .post-row__title {
    color: var(--teal-deep);
  }

  .post-row__desc {
    font-size: 0.84rem;
    line-height: 1.6;
    color: var(--muted);
  }

  .post-row__arrow {
    display: grid;
    place-items: center;
    inline-size: 2.2rem;
    block-size: 2.2rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--teal-deep);
    transition: background 220ms var(--ease), color 220ms var(--ease), border-color 220ms var(--ease);
  }

  .post-row:hover .post-row__arrow {
    background: var(--teal);
    border-color: var(--teal);
    color: var(--paper);
  }

  @media (max-width: 860px) {
    .post-row {
      grid-template-columns: minmax(0, 1fr) 1.9rem;
    }

    .post-row__date {
      grid-column: 1 / -1;
      order: -1;
    }

    .post-row__desc {
      display: none;
    }

    .post-row__arrow {
      grid-column: 2;
      grid-row: 2;
      inline-size: 1.9rem;
      block-size: 1.9rem;
    }

    .latest__arrow {
      display: none;
    }
  }
</style>
